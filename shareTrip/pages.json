			"text": "喜欢"
		},{
			"pagePath": "pages/myPage/myPage",
			"iconPath": "/static/tabbar/geren01.png",
			"selectedIconPath": "/static/tabbar/geren.png",
			"text": "个人信息"
		}]
	},
	"globalStyle": {
		"navigationBarTextStyle": "black",
