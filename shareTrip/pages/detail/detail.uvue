								color: #111;
								margin-bottom: 15rpx;
								text-overflow: ellipsis;
							}
							.desc{
								display: flex;
								justify-content: flex-start;
								align-items: center;
								flex-direction: row;
								.text{
									font-size: 26rpx;
									color: #8a8a8a;
								}
							}
						}
					}
				}
			}
		}
	}
