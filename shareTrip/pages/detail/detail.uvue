<template>
	<view class="detail">
		<uv-navbar bg-color="#00000000" left-icon-color="#fff" :auto-back="true"></uv-navbar>
		<view class="d-con">
			<image :src="details.dt.img"></image>
			<view class="d-content">
				<view class="v-con">
					<view class="d-title" style="display: flex;flex-direction: row;">
						<text>{{ details.dt.title }}</text>
						<uv-tags text="5A级风景区" size="mini" shape="circle"></uv-tags>
					</view>
					<view class="d-view">
						<view class="d-txt">景点介绍</view>
						<view class="d-introduce"> {{ details.dt.introduce }}</view>
					</view>
					<view class="v-con">
						<view class="d-view">
							<view class="d-txt">开放时间</view>
							<view class="d-introduce">{{ details.dt.times }}</view>
						</view>
					</view>
					<view class="v-con content">
						<view class="d-title" style="font-size: 17px;">游玩推荐</view>
						<view class="d-view plist">
							<view class="item" v-for="(item, index) in projectList" :key="index" @click="playDetail(item)">
								<image :src="item.url" mode="aspectFill"></image>
								<view class="topFixed">{{item.tag}}</view>
								<view class="infos">
									<view class="tit">{{item.title}}</view>
									<view class="desc">
										<uni-icons type="location" color="#9c9c9c" size="16"></uni-icons>
										<text class="text">{{item.desc}}</text>
									</view>
								</view>
							</view>
						</view>
					</view>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup>
	import { detailProject } from '../../api/api'
	import { projectList_type } from '../../api/detailType.uts'
	// 景点详情数据
	const details = reactive({
		dt: {}
	})
	// 游玩项目数据
	const projectList = ref<projectList_type[]>([])
	onLoad((opt: { item: string}) => {
		const detailData = JSON.parse(decodeURIComponent(opt.item))
		console.log(detailData, 'detailData')
		details.dt = detailData
		// 获取游玩项目
		detailProject().then((res: projectList_type[]) => {
			projectList.value = res
		})
	})
	// 游玩项目详情
	const playDetail = (item: projectList_type) => {
		uni.navigateTo({
			url: `/pages/play/play?id=${item.id}`
		})
	}
</script>

