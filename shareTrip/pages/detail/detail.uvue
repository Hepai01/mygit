					.item{
						position: relative;
						width: 48%;
						margin-bottom: 20rpx;
						box-shadow: 1px 2px 3px #e5e5e5;
						border-top-left-radius: 20rpx;
						border-top-right-radius: 20rpx;
						overflow: hidden;
						.topFixed{
							position: absolute;
							top: 0;
